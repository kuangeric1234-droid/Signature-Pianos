{
  "images": {
    "sizes": [256, 384, 640, 960, 1280],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 86400,
    "remotePatterns": [{ "protocol": "https", "hostname": "portal.signaturepianos.com.au", "pathname": "/public/**" }]
  },
  "crons": [
    { "path": "/api/cron-delivery-reminders", "schedule": "0 22 * * *" }
  ],
  "redirects": [
    { "source": "/",              "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }], "destination": "/admin/index.html",    "permanent": false },
    { "source": "/index.html",    "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }], "destination": "/admin/index.html",    "permanent": false },
    { "source": "/teachers.html", "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }], "destination": "/admin/teachers.html", "permanent": false },

    { "source": "/piano.html", "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[a-z0-9]+(?:-[a-z0-9]+)*)" }], "destination": "/pianos/:slug", "permanent": true },
    { "source": "/piano.html",          "destination": "/pianos/",          "permanent": true },
    { "source": "/instruments/:path*",  "has": [{ "type": "query", "key": "cat", "value": "upright" }], "destination": "/pianos/uprights/", "permanent": true },
    { "source": "/instruments/:path*",  "has": [{ "type": "query", "key": "cat", "value": "grand" }],   "destination": "/pianos/grands/",   "permanent": true },
    { "source": "/instruments",         "destination": "/pianos/",          "permanent": true },
    { "source": "/instruments/:path*",  "destination": "/pianos/",          "permanent": true },
    { "source": "/instruments.html",    "destination": "/pianos/",          "permanent": true },
    { "source": "/index.html",          "destination": "/",                 "permanent": true },
    { "source": "/pianos",              "destination": "/pianos/",          "permanent": true },
    { "source": "/pianos/:cat(uprights|grands|yamaha|kawai)", "destination": "/pianos/:cat/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/blog",        "destination": "/api/blog"                 },
    { "source": "/blog/:slug",  "destination": "/api/blog-post?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap"              },
    { "source": "/llms.txt",    "destination": "/api/llms"                 },
    { "source": "/guide",       "destination": "/guide.html"               },

    { "source": "/privacy",            "destination": "/privacy.html" },
    { "source": "/piano-rental",       "destination": "/piano-rental/index.html" },
    { "source": "/piano-rental/:page", "destination": "/piano-rental/:page.html" },

    { "source": "/delivery/accept/:token", "destination": "/delivery/accept.html?token=:token"  },
    { "source": "/delivery/drop/:token",   "destination": "/delivery/dropoff.html?token=:token" },
    { "source": "/delivery/:token",        "destination": "/delivery/pickup.html?token=:token"  },

    { "source": "/tuner/respond/:token",   "destination": "/tuner/respond.html?token=:token"   },
    { "source": "/tuner/log-date/:token",  "destination": "/tuner/log-date.html?token=:token"  },

    { "source": "/portal",                 "destination": "/portal/index.html"     },
    { "source": "/portal/dashboard",       "destination": "/portal/dashboard.html" },

    { "source": "/admin/countersign",      "destination": "/admin/countersign.html" },

    {
      "source": "/js/(.*)",
      "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }],
      "destination": "/js/$1"
    },
    {
      "source": "/media/(.*)",
      "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }],
      "destination": "/media/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.signaturepianos.com.au" }],
      "destination": "/admin/$1"
    },

    { "source": "/",        "destination": "/api/site?page=home" },
    { "source": "/pianos/", "destination": "/api/site?page=collection" },
    { "source": "/pianos/:cat(uprights|grands|yamaha|kawai)/", "destination": "/api/site?page=collection&cat=:cat" },
    { "source": "/pianos/:slug", "destination": "/api/site?page=piano&slug=:slug" }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 20
    },
    "api/marketing-audit.js": { "maxDuration": 300 },
    "api/blog-generate.js": { "maxDuration": 300 },
    "api/run-blog-writer.js": { "maxDuration": 300 },
    "api/cron-blog-writer.js": { "maxDuration": 300 },
    "api/seo-engine.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/media/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/v/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/media/site/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
